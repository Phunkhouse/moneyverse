// The daily encrypted backup to R2 (ADR 0006, docs/runbook.md). Deployed by the owner with
// `pnpm dlx wrangler@4.162.0 deploy` from this folder; never from CI.
{
  "name": "moneyverse-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  // Runs only on its schedule: no workers.dev URL and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // 02:30 UTC daily (03:30 or 04:30 in Prague).
  "triggers": { "crons": ["30 2 * * *"] },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "moneyverse-backups" }],
  "observability": { "enabled": true },
  // TURSO_DATABASE_URL, TURSO_READ_TOKEN and BACKUP_PUBLIC_KEY are secrets (wrangler secret put).
}
