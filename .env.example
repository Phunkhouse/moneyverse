# Copy to .env.local for local development. Names and safe examples only; never commit real values.

# Local libSQL file (created by `pnpm db:migrate`). Production: the Turso database URL (libsql://...).
DATABASE_URL=file:.data/dev.db
# Turso only; leave empty for a local file.
DATABASE_AUTH_TOKEN=

# At least 32 random characters, e.g. `openssl rand -base64 32`. A different value per environment.
BETTER_AUTH_SECRET=
# The app's origin. Passkeys are bound to its host name.
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron sends it as `Authorization: Bearer ...` to /api/cron/rates. Letters and digits, at least
# 16, e.g. `openssl rand -hex 24`. Optional locally.
CRON_SECRET=
